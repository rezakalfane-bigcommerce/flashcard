# Orðspor environment configuration
# Copy this file to .env.local for local development.
# Never commit real API keys.

# Required locally for the OpenAI and Gemini translation buttons in /admin.
# Create a key in the Vercel AI Gateway dashboard.
# Vercel deployments may authenticate through OIDC instead of this key.
AI_GATEWAY_API_KEY=

# Optional absolute or project-relative path to the SQLite database.
# Leave blank to use the default: data/phrases.db
# Example: SQLITE_PATH=/var/data/phrases.db
SQLITE_PATH=

# Google TTS API Key
GOOGLE_TTS_API_KEY=

# Clerk authentication (provisioned by the Vercel Marketplace integration).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Turso Cloud development database (provisioned by Vercel Marketplace).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Vercel Blob public audio store (provisioned by Vercel).
BLOB_READ_WRITE_TOKEN=

# The following variables are optional locally but are useful when mirroring
# the Vercel development project. Keep .env.local private; never commit it.
# ADMIN_EMAILS controls the admin area. Use comma-separated primary emails.
ADMIN_EMAILS=
